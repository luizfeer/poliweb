/*
  X-Content-Type-Options: nosniff

/index.html
  Cache-Control: no-cache, no-store, must-revalidate

/manifest.json
  Cache-Control: no-cache, no-store, must-revalidate

/service-worker.js
  Cache-Control: no-cache, no-store, must-revalidate

/js/chunk-common.e6a3fe80.js
  Cache-Control: no-cache, no-store, must-revalidate

/js/*
  Cache-Control: no-cache, no-store, must-revalidate

/css/*
  Cache-Control: no-cache, no-store, must-revalidate

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/img/*
  Cache-Control: public, max-age=31536000, immutable

/icons/*
  Cache-Control: public, max-age=31536000, immutable

/.well-known/*
  Cache-Control: public, max-age=3600
