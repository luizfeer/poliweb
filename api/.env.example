# PostgreSQL da API principal (poliwebapp-api). A migração cria as tabelas neste banco.
DATABASE_URL=postgres://usuario:senha@127.0.0.1:5432/poliweb

# Porta do processo. No Lightsail, o nginx do apiv4 deve encaminhar /push para cá.
PORT=5055
HOST=127.0.0.1

# Mesmo segredo HS256 do @fastify/jwt da API. Sem ele o dispositivo ainda grava
# cidade e token, mas o user_id do cliente logado não é vinculado.
JWT_SECRET=

# Opcional. Se o admin não usar o JWT da API, um Bearer com este valor também autoriza o disparo.
PUSH_ADMIN_SECRET=

# Usado só quando o JWT não se identifica como admin: GET {UPSTREAM}/customers com o mesmo Bearer.
UPSTREAM_API_URL=https://apiv4.poliwebapp.com.br

# Origens do site. Separe por vírgula. Vazio libera qualquer origem.
CORS_ORIGINS=https://www.poliwebapp.com.br,https://poliwebapp.com.br,http://localhost:3050

# Chaves VAPID (navegador e TWA Android). Gere com: npm run vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:aplicativopoliweb@gmail.com

# Opcional. Access token da Expo, se a conta exigir.
EXPO_ACCESS_TOKEN=

# Prefixo absoluto colocado em data.url. O app iOS aceita data.path e data.url.
PUBLIC_SITE_URL=https://www.poliwebapp.com.br

# Teto de dispositivos por disparo.
PUSH_MAX_DEVICES=20000

# memory: sobe sem Postgres, só para ensaio local. Os dados somem ao encerrar o processo.
# PUSH_DB=memory
