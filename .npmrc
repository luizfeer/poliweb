# Expo/React Native: hoist só o necessário para autolinking (sem node-linker=hoisted global,
# que quebra resolução do next na Vercel quando Root Directory = apps/web).
public-hoist-pattern[]=*expo*
public-hoist-pattern[]=*react-native*
public-hoist-pattern[]=@react-native/*
public-hoist-pattern[]=metro*
