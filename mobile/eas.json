{
  "cli": {
    "version": ">= 16.17.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "autoIncrement": true,
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "autoIncrement": true
    },
    "production": {
      "distribution": "store",
      "autoIncrement": true,
      "buildArtifactPaths": [
        "ios/build/**/*.dSYM/**/*",
        "ios/build/**/*.map",
        "/Users/expo/Library/Developer/Xcode/Archives/**/PoliwebAgenda.app.dSYM/**/*"
      ],
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "1659657349",
        "appleTeamId": "Y6FSFUALV7"
      },
      "android": {
        "track": "internal"
      }
    }
  }
}
