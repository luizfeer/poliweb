# Copie para .env ou rode na raiz do monorepo: pnpm env:sync-mobile
# (lê apps/web/.env.local e gera este arquivo automaticamente)

# URL do Next (webview + /api/mobile/*). Em dev = NEXT_PUBLIC_APP_URL do web.
# No celular físico, use o IP da máquina em vez de localhost.
EXPO_PUBLIC_WEB_URL=http://localhost:3000

# =1 força dev local (nunca cai em portalcarmelitano.com.br). Obrigatório em dev no device.
EXPO_PUBLIC_ALLOW_LOCALHOST_WEB_URL=1

# Mesmos valores do web (NEXT_PUBLIC_SUPABASE_*)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Mesmo que NEXT_PUBLIC_DEFAULT_CITY_SLUG no web
EXPO_PUBLIC_DEFAULT_CITY_SLUG=carmo-do-rio-claro

# Google Maps SDK for Android (react-native-maps). Restringir no GCP:
# package com.portalcarmelitano.app + SHA-1 do keystore EAS/debug.
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_ANDROID_KEY

# Expo / EAS (defaults já estão hardcoded em app.config.ts;
# só sobrescreva se for clonar pra outro projeto Expo).
# EAS_PROJECT_ID=
# EAS_UPDATE_URL=  # default: https://u.expo.dev/$EAS_PROJECT_ID
