SUPABASE_URL=https://project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-me
WORKER_CITY_SLUG=carmo-do-rio-claro
GOOGLE_PLACES_API_KEY=replace-me
GOOGLE_ROUTES_API_KEY=

# Cloudflare R2 (S3-compatible)
R2_ENDPOINT=https://2acb67e5ffc1608e0ee2974fc86515ca.r2.cloudflarestorage.com
R2_BUCKET=cidade-viva
R2_ACCESS_KEY_ID=replace-me
R2_SECRET_ACCESS_KEY=replace-me
R2_PUBLIC_BASE_URL=https://cdn.cidadeviva.app

OPENAI_API_KEY=replace-me
OPENAI_SUMMARY_MODEL=gpt-5.4-nano
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
AI_MONTHLY_BUDGET_USD=5
WORKER_HTTP_TIMEOUT_MS=15000
WORKER_MAX_RETRIES=2

# Email transacional
# O envio Brevo roda no projeto separado email-dispatcher.
# Este worker nao guarda chaves Brevo.
APP_URL=https://portalcarmelitano.com.br

# Web Push (VAPID)
VAPID_PUBLIC_KEY=replace-me
VAPID_PRIVATE_KEY=replace-me
VAPID_SUBJECT=mailto:contato@cidadeviva.app

# Media processor (opcional). Se setado, imports de fotos do Google passam pelo serviço
# em vez de converter localmente via sharp. Necessário pra suporte a vídeo.
MEDIA_PROCESSOR_URL=
MEDIA_PROCESSOR_SECRET=

# Web Push (VAPID). Gerar com: `npx web-push generate-vapid-keys`
# A pública também precisa estar em apps/web/.env.local como NEXT_PUBLIC_VAPID_PUBLIC_KEY.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@cidadeviva.app
PUSH_POLL_INTERVAL_MS=5000
PUSH_BATCH_SIZE=50

# Janela (em dias) pro job media:sweep-orphans. Padrão 14.
MEDIA_SWEEP_GRACE_DAYS=14
