{
  "name": "hail-mary",
  "version": "0.0.0",
  "private": true,
  "description": "Portal hiperlocal de Carmo do Rio Claro/MG",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "cidadeviva:dev": "pnpm --filter cidadeviva dev",
    "cidadeviva:build": "pnpm --filter cidadeviva build",
    "cidadeviva:start": "pnpm --filter cidadeviva start",
    "db:link": "npx supabase link --project-ref szdzoxfvugxcrpfsabbv",
    "db:push": "npx supabase db push",
    "db:migration:list": "npx supabase migration list",
    "db:types": "npx supabase gen types typescript --linked > apps/web/lib/supabase/database.types.ts",
    "supabase:auth:templates:push": "node scripts/push-supabase-auth-templates.mjs",
    "build": "pnpm --filter web build",
    "worker:build": "pnpm --filter worker build",
    "agent:build": "pnpm --filter agent build",
    "agent:start": "pnpm --filter agent start",
    "worker:scrape:diario": "pnpm --filter worker scrape:diario",
    "worker:scrape:atas": "pnpm --filter worker scrape:atas",
    "worker:scrape:licitacoes": "pnpm --filter worker scrape:licitacoes",
    "worker:scrape:noticias-camara": "pnpm --filter worker scrape:noticias-camara",
    "worker:scrape:noticias-prefeitura": "pnpm --filter worker scrape:noticias-prefeitura",
    "worker:scrape:proposicoes": "pnpm --filter worker scrape:proposicoes",
    "worker:scrape:all": "pnpm --filter worker scrape:all",
    "worker:road-routes:update": "pnpm --filter worker road-routes:update",
    "worker:import:cliqueiachei-businesses": "pnpm --filter worker import:cliqueiachei-businesses",
    "worker:import:google-business-photos": "pnpm --filter worker import:google-business-photos",
    "worker:estimate:ia": "pnpm --filter worker estimate:ia",
    "media:build": "pnpm --filter media-processor build",
    "media:start": "pnpm --filter media-processor start",
    "media:dev": "pnpm --filter media-processor dev",
    "start": "pnpm --filter web start",
    "lint": "pnpm --filter web lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "davia:open": "davia open",
    "davia:push": "davia push",
    "env:sync-mobile": "node scripts/sync-mobile-env.mjs"
  },
  "devDependencies": {
    "next": "16.2.4",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.8"
  },
  "engines": {
    "node": "20.x",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@10.15.1"
}
