{
  "name": "mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "prestart": "node ./config/write-runtime-env.cjs",
    "start": "expo start",
    "start:local": "node ./config/write-runtime-env.cjs && expo start -c",
    "dev": "node ./config/write-runtime-env.cjs && expo start --dev-client",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "node ./config/write-runtime-env.cjs && tsc --noEmit",
    "prebuild": "expo prebuild",
    "build:ios:dev": "eas build --profile development --platform ios",
    "build:ios:sim": "eas build --profile development-simulator --platform ios",
    "build:android:dev": "eas build --profile development --platform android",
    "build:preview": "eas build --profile preview",
    "build:prod": "eas build --profile production",
    "update:dev": "eas update --branch development --auto",
    "update:preview": "eas update --branch preview --auto",
    "update:prod": "eas update --branch production --auto",
    "submit:ios": "eas submit -p ios",
    "submit:android": "eas submit -p android"
  },
  "dependencies": {
    "@expo/metro-runtime": "^55.0.11",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.45.4",
    "expo": "~55.0.24",
    "expo-apple-authentication": "^55.0.13",
    "expo-application": "~55.0.15",
    "expo-audio": "~55.0.14",
    "expo-blur": "~55.0.14",
    "expo-clipboard": "~55.0.13",
    "expo-constants": "~55.0.16",
    "expo-dev-client": "~55.0.34",
    "expo-device": "~55.0.17",
    "expo-file-system": "^55.0.22",
    "expo-font": "~55.0.8",
    "expo-haptics": "~55.0.14",
    "expo-image": "~55.0.10",
    "expo-image-manipulator": "^55.0.17",
    "expo-image-picker": "^55.0.20",
    "expo-linear-gradient": "~55.0.14",
    "expo-linking": "~55.0.15",
    "expo-localization": "~55.0.14",
    "expo-location": "~55.1.10",
    "expo-notifications": "~55.0.23",
    "expo-router": "~55.0.14",
    "expo-secure-store": "~55.0.14",
    "expo-speech-recognition": "^2.1.5",
    "expo-splash-screen": "~55.0.21",
    "expo-sqlite": "~55.0.16",
    "expo-status-bar": "~55.0.6",
    "expo-system-ui": "~55.0.18",
    "expo-updates": "~55.0.22",
    "expo-video": "~55.0.17",
    "expo-web-browser": "~55.0.16",
    "lucide-react-native": "^1.16.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.6",
    "react-native-gesture-handler": "~2.30.1",
    "react-native-maps": "1.27.2",
    "react-native-reanimated": "~4.2.1",
    "react-native-safe-area-context": "5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-webview": "13.16.0",
    "react-native-worklets": "0.7.4",
    "whatwg-fetch": "^3.6.20",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/react": "~19.2.14",
    "babel-preset-expo": "~55.0.21",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~55.0.1",
    "typescript": "~5.9.3"
  }
}
