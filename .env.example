# Copy to apps/web/.env.local and fill in real values. Never commit .env.local.
# App mobile: na raiz, `pnpm env:sync-mobile` gera apps/mobile/.env a partir deste arquivo.

# ─── Supabase (apps/web) ──────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — never expose to the client
SUPABASE_SERVICE_ROLE_KEY=

# ─── Anthropic (Claude) ───────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ─── Resend (email transacional + newsletter) ─────────────────────────
RESEND_API_KEY=
RESEND_AUDIENCE_ID=
RESEND_FROM_EMAIL=contato@carmodorioclaro.com.br

# ─── App ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_CITY_SLUG=carmo-do-rio-claro

# ─── Cron jobs ────────────────────────────────────────────────────────
# Bearer token usado pelos endpoints /api/cron/* (Vercel Cron, cron-job.org, etc.)
CRON_SECRET=
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ─── Cloudflare R2 (upload de mídia, S3-compatible) ───────────────────
# Endpoint do bucket (https://<account-id>.r2.cloudflarestorage.com)
R2_ENDPOINT=https://2acb67e5ffc1608e0ee2974fc86515ca.r2.cloudflarestorage.com
R2_BUCKET=cidade-viva
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Custom domain ligado ao bucket no painel R2
R2_PUBLIC_BASE_URL=https://cdn.cidadeviva.app
NEXT_PUBLIC_R2_PUBLIC_BASE_URL=https://cdn.cidadeviva.app
# Tamanho máximo de upload aceito pela web (bytes). Default 200 MB.
R2_MEDIA_MAX_BYTES=209715200

# ─── Media Processor (apps/media-processor) ───────────────────────────
# URL do serviço de compressão rodando localmente ou em produção
MEDIA_PROCESSOR_URL=http://127.0.0.1:4010
# Segredo compartilhado entre web e media-processor (min 24 chars)
MEDIA_PROCESSOR_SECRET=
